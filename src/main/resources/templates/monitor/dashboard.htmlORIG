<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
<head>

    <title>Campaign Monitor</title>

    <meta http-equiv="refresh" content="5"/>

</head>
<body>

<h2>Campaign Monitoring Dashboard</h2>

<a href="/">Home</a>

<table border="1">

<tr>
    <th>ID</th>
    <th>Name</th>
    <th>Status</th>
    <th>PID</th>
    <th>Start Time</th>
    <th>Action</th>
</tr>

<tr th:each="c : ${campaigns}">

    <td th:text="${c.campaignId}"></td>
    <td th:text="${c.campaignName}"></td>
    <td th:text="${c.status}"></td>
    <td th:text="${c.sippPid}"></td>
    <td th:text="${c.startTime}"></td>

    <td>
        <a th:href="@{/monitor/{id}(id=${c.campaignId})}">
            View
        </a>
    </td>

</tr>

</table>

</body>
</html>
